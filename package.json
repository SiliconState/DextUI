{
  "name": "dextui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @dextui/protocol && npm run build -w @dextui/client && npm run build -w @dextui/web",
    "typecheck": "npm run typecheck -w @dextui/protocol && npm run typecheck -w @dextui/client && npm run typecheck -w @dextui/web",
    "dev": "npm run dev -w @dextui/web",
    "test": "node --test packages/client/test/*.test.mjs",
    "mock": "node packages/mock-server/src/server.mjs",
    "serve": "node packages/agentlinkd/src/server.mjs",
    "smoke": "node packages/mock-server/scripts/smoke.mjs",
    "smoke:agentlinkd": "node packages/agentlinkd/scripts/smoke.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "svelte": "^5.43.0",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.1"
  }
}
